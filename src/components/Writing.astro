---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const INITIAL_SHOW = 3;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<section id="writing" class="px-6 pb-16 max-w-2xl mx-auto">
  <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-5">
    &#9997;&#65039; Writing
  </h2>

  <div class="space-y-1">
    {posts.map((post, i) => (
      <a
        href={`/writing/${post.id}`}
        class={`group flex items-start justify-between gap-4 rounded-xl px-4 py-3 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors ${i >= INITIAL_SHOW ? 'hidden' : ''}`}
        data-post-card
      >
        <div class="min-w-0">
          <p class="text-sm text-neutral-900 dark:text-white font-medium">{post.data.title}</p>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-0.5 leading-relaxed line-clamp-1">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-1.5">
              {post.data.tags.map(tag => (
                <span class="text-xs px-1.5 py-0.5 rounded bg-neutral-100 border border-neutral-200 text-neutral-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-500">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <span class="text-xs text-neutral-400 dark:text-neutral-600 shrink-0 pt-0.5">{formatDate(post.data.date)}</span>
      </a>
    ))}
  </div>

  {posts.length > INITIAL_SHOW && (
    <button
      id="toggle-posts"
      class="mt-3 text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors flex items-center gap-1"
    >
      <span id="toggle-posts-label">Show more</span>
      <span id="toggle-posts-icon">↓</span>
    </button>
  )}
</section>

<script>
  const btn = document.getElementById('toggle-posts');
  const label = document.getElementById('toggle-posts-label');
  const icon = document.getElementById('toggle-posts-icon');
  const cards = document.querySelectorAll('[data-post-card]');
  const INITIAL_SHOW = 3;
  let expanded = false;

  btn?.addEventListener('click', () => {
    expanded = !expanded;
    cards.forEach((card, i) => {
      if (i >= INITIAL_SHOW) {
        card.classList.toggle('hidden', !expanded);
      }
    });
    if (label) label.textContent = expanded ? 'Show less' : 'Show more';
    if (icon) icon.textContent = expanded ? '↑' : '↓';
  });
</script>
