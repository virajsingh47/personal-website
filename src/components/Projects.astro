---
import { projects } from '../data/projects';

const INITIAL_SHOW = 3;
---

<section id="projects" class="px-6 pb-16 max-w-2xl mx-auto">
  <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-5">
    Projects
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="projects-grid">
    {projects.map((project, i) => (
      <a
        href={project.url ?? '#'}
        target={project.url && project.url !== '#' ? '_blank' : undefined}
        rel="noopener noreferrer"
        class={`group block rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 p-4 hover:border-neutral-300 dark:hover:border-neutral-600 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all ${i >= INITIAL_SHOW ? 'hidden' : ''}`}
        data-project-card
      >
        <div class="flex items-start gap-3">
          {project.icon?.startsWith('/')
            ? <img src={project.icon} alt={project.name} class="w-8 h-8 object-contain" />
            : <span class="text-2xl">{project.icon ?? '📦'}</span>
          }
          <div class="min-w-0">
            <p class="text-sm font-medium text-neutral-900 dark:text-white">{project.name}</p>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed line-clamp-3">{project.description}</p>
          </div>
        </div>
      </a>
    ))}
  </div>

  {projects.length > INITIAL_SHOW && (
    <button
      id="toggle-projects"
      class="mt-4 text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors flex items-center gap-1"
    >
      <span id="toggle-projects-label">Show more</span>
      <span id="toggle-projects-icon">↓</span>
    </button>
  )}
</section>

<script>
  const btn = document.getElementById('toggle-projects');
  const label = document.getElementById('toggle-projects-label');
  const icon = document.getElementById('toggle-projects-icon');
  const cards = document.querySelectorAll('[data-project-card]');
  const INITIAL_SHOW = 3;
  let expanded = false;

  btn?.addEventListener('click', () => {
    expanded = !expanded;
    cards.forEach((card, i) => {
      if (i >= INITIAL_SHOW) {
        card.classList.toggle('hidden', !expanded);
      }
    });
    if (label) label.textContent = expanded ? 'Show less' : 'Show more';
    if (icon) icon.textContent = expanded ? '↑' : '↓';
  });
</script>
