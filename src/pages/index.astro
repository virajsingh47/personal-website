---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WorkExperience from '../components/WorkExperience.astro';
import Education from '../components/Education.astro';
import Volunteering from '../components/Volunteering.astro';

---

<Layout title="Viraj Singh" description="Product manager, builder, writer.">
  <main>
    <Hero />
    <Projects />
    <hr class="border-neutral-200 dark:border-neutral-800 max-w-2xl mx-auto mb-12" />
    <WorkExperience />
    <hr class="border-neutral-200 dark:border-neutral-800 max-w-2xl mx-auto mb-12" />
    <Education />
    <hr class="border-neutral-200 dark:border-neutral-800 max-w-2xl mx-auto mb-12" />
    <Volunteering />
    <footer class="px-6 pb-10 max-w-2xl mx-auto">
      <p class="text-xs text-neutral-400 dark:text-neutral-700">&copy; Viraj Singh {new Date().getFullYear()}</p>
    </footer>
  </main>
</Layout>
